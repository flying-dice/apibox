{
  "name": "@apibox/ui",
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens/index.css",
    "./themes/dark.css": "./src/tokens/theme-dark.css",
    "./themes/light.css": "./src/tokens/theme-light.css",
    "./themes/high-contrast.css": "./src/tokens/theme-high-contrast.css"
  },
  "scripts": {
    "build": "svelte-check --tsconfig ./tsconfig.json --threshold error",
    "dev": "storybook dev -p 6006 --no-open --disable-telemetry",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --threshold error",
    "test": "vitest run",
    "storybook": "bun run dev",
    "build-storybook": "storybook build --disable-telemetry"
  },
  "dependencies": {
    "@apibox/core": "workspace:*"
  },
  "devDependencies": {
    "@storybook/addon-svelte-csf": "5.1.3",
    "@storybook/svelte-vite": "10.6.0",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "@testing-library/user-event": "14.6.7",
    "jsdom": "30.0.1",
    "storybook": "10.6.0",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}

{
  "name": "apibox-vscode",
  "displayName": "APIBox",
  "description": "Preview API specifications and publish them as static documentation.",
  "version": "0.1.0",
  "publisher": "flying-dice",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/flying-dice/apibox.git"
  },
  "type": "module",
  "engines": {
    "vscode": "^1.136.0"
  },
  "main": "./dist/extension.js",
  "files": [
    "LICENSE",
    "icons",
    "dist",
    "media",
    "static-viewer"
  ],
  "activationEvents": [
    "onCustomEditor:apibox.preview",
    "onCommand:apibox.preview",
    "onCommand:apibox.build",
    "onCommand:apibox.deploy",
    "onView:apibox.documents"
  ],
  "contributes": {
    "commands": [
      {
        "command": "apibox.preview",
        "title": "Preview API Document",
        "category": "APIBox"
      },
      {
        "command": "apibox.build",
        "title": "Build Static Site",
        "category": "APIBox"
      },
      {
        "command": "apibox.deploy",
        "title": "Deploy Static Site to GitHub Pages",
        "category": "APIBox"
      },
      {
        "command": "apibox.refreshDocuments",
        "title": "Refresh",
        "category": "APIBox",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "apibox.preview",
          "when": "resourceExtname == .yaml || resourceExtname == .yml || resourceExtname == .json",
          "group": "navigation@20"
        }
      ],
      "editor/context": [
        {
          "command": "apibox.preview",
          "when": "resourceExtname == .yaml || resourceExtname == .yml || resourceExtname == .json",
          "group": "navigation@20"
        }
      ],
      "view/title": [
        {
          "command": "apibox.refreshDocuments",
          "when": "view == apibox.documents",
          "group": "navigation"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "apibox.preview",
        "displayName": "APIBox Preview",
        "selector": [
          {
            "filenamePattern": "*.yaml"
          },
          {
            "filenamePattern": "*.yml"
          },
          {
            "filenamePattern": "*.json"
          }
        ],
        "priority": "option"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "apibox",
          "title": "APIBox",
          "icon": "icons/activity-bar.svg"
        }
      ]
    },
    "views": {
      "apibox": [
        {
          "id": "apibox.documents",
          "name": "Documents"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "apibox.documents",
        "contents": "No API documents detected in this workspace.\n[Refresh](command:apibox.refreshDocuments)\nAdjust the `apibox.include` and `apibox.exclude` settings to widen or narrow the scan."
      }
    ],
    "configuration": {
      "title": "APIBox",
      "properties": {
        "apibox.include": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/*.{yaml,yml,json}"
          ],
          "description": "Glob patterns scanned for API documents shown in the APIBox activity bar rail."
        },
        "apibox.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**"
          ],
          "description": "Glob patterns excluded from the APIBox document scan."
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:watch": "bun run --cwd ../core build && bun run --cwd ../cli build && bun run --cwd ../viewer build:webview && bun run sync-assets && node scripts/build.mjs --watch",
    "sync-assets": "node scripts/sync-assets.mjs",
    "package": "bun run sync-assets && bun run build && vsce package --no-dependencies",
    "test:vscode": "bun run build && tsc -p tsconfig.test.json && vscode-test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src/*.test.ts"
  },
  "dependencies": {
    "@apibox/cli": "workspace:*",
    "@apibox/core": "workspace:*",
    "@apibox/viewer": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/mocha": "^10.0.10",
    "@types/vscode": "1.136.0",
    "@vscode/vsce": "^3.9.2",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.2",
    "mocha": "^12.0.0",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}

{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run APIBox Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/packages/extension",
        "${workspaceFolder}/examples"
      ],
      "outFiles": ["${workspaceFolder}/packages/extension/dist/**/*.js"],
      "preLaunchTask": "Develop APIBox Extension"
    }
  ]
}

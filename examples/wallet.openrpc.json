{
  "openrpc": "1.2.6",
  "x-internal-id": "wallet-rpc",
  "info": {
    "title": "Wallet RPC",
    "version": "2.1.0",
    "summary": "Query balances and send transfers over JSON-RPC.",
    "description": "A JSON-RPC 2.0 interface for querying balances and sending transfers.",
    "termsOfService": "https://example.com/wallet-rpc-terms"
  },
  "externalDocs": {
    "description": "Full API guide",
    "url": "https://docs.example.com/wallet-rpc"
  },
  "servers": [
    {
      "name": "mainnet",
      "url": "https://{environment}.rpc.example.com",
      "summary": "Production node",
      "variables": {
        "environment": {
          "default": "mainnet",
          "enum": ["mainnet", "testnet"],
          "description": "Network to connect to."
        }
      }
    }
  ],
  "methods": [
    {
      "name": "getBalance",
      "summary": "Get an account balance",
      "description": "Returns the confirmed balance of an account, in the smallest unit.",
      "tags": [
        {
          "name": "accounts",
          "description": "Methods for inspecting account state.",
          "externalDocs": {
            "url": "https://docs.example.com/accounts"
          }
        }
      ],
      "params": [
        {
          "name": "address",
          "description": "The account to query.",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^0x[a-fA-F0-9]{40}$",
            "examples": ["0x0000000000000000000000000000000000000001"]
          }
        },
        {
          "name": "block",
          "description": "Block height, or the string 'latest'.",
          "required": false,
          "schema": {
            "oneOf": [
              {
                "type": "integer"
              },
              {
                "type": "string",
                "enum": ["latest", "pending"]
              }
            ]
          }
        },
        {
          "name": "legacyFormat",
          "description": "Return the balance as a hex string instead of decimal.",
          "required": false,
          "deprecated": true,
          "schema": {
            "type": "boolean"
          }
        }
      ],
      "result": {
        "name": "balance",
        "description": "The balance in the smallest unit.",
        "schema": {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      },
      "errors": [
        {
          "code": -32001,
          "message": "Unknown account"
        }
      ],
      "examples": [
        {
          "name": "A funded account",
          "params": [
            {
              "name": "address",
              "value": "0x0000000000000000000000000000000000000001"
            }
          ],
          "result": {
            "name": "balance",
            "value": "1250000000000000000"
          }
        },
        {
          "name": "A remotely hosted example",
          "params": [
            {
              "name": "address",
              "externalValue": "https://example.com/examples/address.json"
            }
          ],
          "result": {
            "name": "balance",
            "externalValue": "https://example.com/examples/balance.json"
          }
        }
      ],
      "links": [
        {
          "name": "SendTransferFromAccount",
          "summary": "Send a transfer once the balance is known",
          "description": "Chain into sendTransfer using this account as the transaction sender.",
          "method": "sendTransfer",
          "params": {
            "transaction": "$params.address"
          }
        }
      ]
    },
    {
      "name": "sendTransfer",
      "summary": "Send a transfer",
      "description": "Submits a signed transfer to the network and returns its hash.",
      "tags": [
        {
          "name": "transfers"
        }
      ],
      "externalDocs": {
        "url": "https://docs.example.com/sendTransfer"
      },
      "servers": [
        {
          "name": "relay",
          "url": "https://relay.example.com",
          "summary": "Dedicated broadcast relay"
        }
      ],
      "params": [
        {
          "name": "transaction",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/Transaction"
          }
        }
      ],
      "result": {
        "name": "hash",
        "description": "The transaction hash. Superseded by `transactionHash` on the relay server.",
        "schema": {
          "type": "string",
          "description": "The transaction hash."
        },
        "deprecated": true
      },
      "errors": [
        {
          "code": -32002,
          "message": "Insufficient funds"
        },
        {
          "code": -32003,
          "message": "Invalid signature"
        }
      ]
    },
    {
      "name": "subscribeBlocks",
      "summary": "Subscribe to new blocks",
      "description": "Opens a subscription that emits a notification for every new block.",
      "tags": [
        {
          "name": "subscriptions"
        }
      ],
      "params": [],
      "result": {
        "name": "subscriptionId",
        "schema": {
          "type": "string"
        }
      }
    }
  ],
  "components": {
    "schemas": {
      "Transaction": {
        "type": "object",
        "description": "A signed transfer.",
        "required": ["from", "to", "value", "signature"],
        "properties": {
          "from": {
            "type": "string",
            "description": "Sender address."
          },
          "to": {
            "type": "string",
            "description": "Recipient address."
          },
          "value": {
            "type": "string",
            "description": "Amount in the smallest unit."
          },
          "signature": {
            "type": "string",
            "description": "Hex-encoded signature."
          },
          "memo": {
            "type": "string",
            "maxLength": 128
          }
        }
      }
    }
  }
}
